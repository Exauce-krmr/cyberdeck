{
  "name": "ecole/toptrump",
  "description": "Cyberdeck : jeu de cartes cyberpunk contre l'ordinateur (projet d'école)",
  "type": "project",
  "require": {
    "php": "^8.4",
    "leafs/leaf": "^5.0",
    "leafs/blade": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "analyse": "phpstan analyse --memory-limit=512M",
    "test": "pest"
  }
}
