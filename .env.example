# Copier ce fichier en .env avant le premier lancement : cp .env.example .env
DB_HOST=db
DB_NAME=cyberdeck
DB_USER=cyberdeck
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Durée du cookie de connexion, en jours
SESSION_DAYS=30

# Le Labo (/dev) : outils de test (se donner des boosters, fabriquer une partie, comptes de test…).
# Éteint par défaut. Pour l'allumer : DEV_TOOLS=1 ET ton pseudo dans DEV_USERS (séparés par des virgules).
# Après modification : docker compose up -d --force-recreate web
DEV_TOOLS=0
DEV_USERS=
# Mot de passe des comptes de test créés par le Labo (facultatif)
#DEV_TEST_PASSWORD=labo-test-1234
